# Copy to .env and fill in. Never commit the real file.

# Zendesk Help Center to sync from, e.g. support.example.com
ZENDESK_HOST=
ZENDESK_LOCALE=en-us

# OpenAI. Leave blank to write Markdown without uploading.
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=

# Chunking: overlap must not exceed half of the chunk size.
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=200

# Optional: cap articles per run (blank = all), and where Markdown is written.
MAX_ARTICLES=
OUT_DIR=articles
