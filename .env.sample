# Copy to .env and fill in. Never commit the real file.

# Zendesk Help Center to sync from, e.g. support.example.com
ZENDESK_HOST=
ZENDESK_LOCALE=en-us

# Gemini File Search. Leave the key blank to write Markdown without uploading.
# Create the store once with: python main.py --create-store kbsync
GEMINI_API_KEY=
GEMINI_FILE_SEARCH_STORE=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Chunking: File Search caps the chunk at 512 tokens; overlap must not exceed half.
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=128

# Optional: cap articles per run (blank = all), and where Markdown is written.
MAX_ARTICLES=
OUT_DIR=articles
